{
  "name": "planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Личный планер дня: PWA + Telegram Mini App + голосовой бот + Notion Calendar. Один Cloudflare Worker.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"tests/*.test.mjs\"",
    "dev:local": "npm run build && wrangler dev -c wrangler.local.toml",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
